# =================================================================
# Automated Multi-Platform Posting System - Environment Configuration
# =================================================================
# Copy this file to .env and populate with your actual credentials.
# All platforms are optional at boot time; any platform without valid
# credentials will be gracefully reported as failed on posting attempts
# while allowing configured platforms to succeed.

# -----------------------------------------------------------------
# 1. Bluesky (AT Protocol)
# -----------------------------------------------------------------
# Obtain an App Password at: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=YOUR_BLUESKY_HANDLE
BLUESKY_APP_PASSWORD=YOUR_BLUESKY_APP_PASSWORD

# -----------------------------------------------------------------
# 2. Mastodon
# -----------------------------------------------------------------
# Obtain access token under: Preferences -> Development -> New Application
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=YOUR_MASTODON_ACCESS_TOKEN

# -----------------------------------------------------------------
# 3. Dev.to (Forem API)
# -----------------------------------------------------------------
# Generate API key at: https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=YOUR_DEVTO_API_KEY
DEVTO_ARTICLE_TITLE=Automated Multi-Platform Announcement

# -----------------------------------------------------------------
# 4. Telegram Bot API
# -----------------------------------------------------------------
# Create bot via @BotFather to get the token.
# Add the bot as Administrator to your channel or group.
# TELEGRAM_CHAT_ID can be numeric (e.g. -1001234567890) or @channel_username.
# TELEGRAM_CHANNEL_USERNAME (without @) is used to construct public t.me URLs.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_CHANNEL_USERNAME=YOUR_TELEGRAM_CHANNEL_USERNAME

# -----------------------------------------------------------------
# 5. Discord Webhook
# -----------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
# Optional Guild (Server) ID for Discord channel navigation links
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# -----------------------------------------------------------------
# System & HTTP Settings
# -----------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10.0
VERIFICATION_TIMEOUT_SECONDS=5.0
